exec alttab
exec sudo brightnessctl s 255
exec nm-applet
exec rpws init 9
exec sh -c 'nohup /home/linaro/.local/bin/clipse -listen >/dev/null 2>&1 &'
exec sh -c 'nohup sudo openvpn --config /etc/openvpn/mullvad_us_lax.conf >/dev/null 2>&1 &'
